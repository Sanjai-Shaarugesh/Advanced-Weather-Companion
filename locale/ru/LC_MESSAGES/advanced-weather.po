#: lib/alerts.js:37
msgid "⚠️ Severe Weather Alert"
msgstr "⚠️ Предупреждение об опасной погоде"

#: lib/alerts.js:46
msgid "⚠️ Weather Warning"
msgstr "⚠️ Метеопредупреждение"

#: lib/alerts.js:66
msgid "🌡️ Extreme Heat Warning"
msgstr "🌡️ Предупреждение об экстремальной жаре"

#: lib/alerts.js:68
msgid "Dangerously high temperature"
msgstr "Опасная высокая температура"

#: lib/alerts.js:75
msgid "Stay indoors during peak hours (10 AM – 4 PM)"
msgstr "Оставайтесь в помещении в пиковые часы (10:00–16:00)"

#: lib/alerts.js:76
msgid "Drink water regularly — at least 2–3 litres per day"
msgstr "Пейте воду регулярно — не менее 2–3 литров в день"

#: lib/alerts.js:77
msgid "Wear light, loose, light-coloured clothing"
msgstr "Носите лёгкую, свободную и светлую одежду"

#: lib/alerts.js:78
msgid "Never leave children or pets in parked vehicles"
msgstr "Никогда не оставляйте детей и животных в припаркованных автомобилях"

#: lib/alerts.js:79
msgid "Check on elderly neighbours and relatives"
msgstr "Проверьте пожилых соседей и родственников"

#: lib/alerts.js:80
msgid "Use fans or air conditioning if available"
msgstr "Используйте вентиляторы или кондиционер, если есть"

#: lib/alerts.js:91
msgid "🥶 Extreme Cold Warning"
msgstr "🥶 Предупреждение об экстремальном холоде"

#: lib/alerts.js:93
msgid "Dangerously low temperature"
msgstr "Опасная низкая температура"

#: lib/alerts.js:100
msgid "Layer clothing: base layer, insulation, waterproof outer shell"
msgstr ""
"Одевайтесь слоями: базовый слой, утепление, водонепроницаемая верхняя одежда"

#: lib/alerts.js:101
msgid "Cover exposed skin — risk of frostbite within 30 minutes"
msgstr "Закройте открытую кожу — обморожение возможно в течение 30 минут"

#: lib/alerts.js:102
msgid "Keep emergency supplies in your vehicle if driving"
msgstr "Держите аварийный запас в машине, если едете"

#: lib/alerts.js:103
msgid "Check heating systems and carbon-monoxide detectors"
msgstr "Проверьте отопление и датчики угарного газа"

#: lib/alerts.js:104
msgid "Check on elderly and vulnerable people"
msgstr "Проявляйте заботу о пожилых и уязвимых людях"

#: lib/alerts.js:105
msgid "Bring pets indoors"
msgstr "Заберите домашних животных в помещение"

#: lib/alerts.js:117
msgid "🌀 Severe Storm Warning"
msgstr "🌀 Предупреждение о сильной буре"

#: lib/alerts.js:119
msgid "Dangerous wind speed"
msgstr "Опасная скорость ветра"

#: lib/alerts.js:121
msgid "Avoid all unnecessary travel"
msgstr "Избегайте всех ненужных поездок"

#: lib/alerts.js:122
msgid "Stay away from trees, scaffolding, and signs"
msgstr "Держитесь подальше от деревьев, строительных лесов и указателей"

#: lib/alerts.js:123
msgid "Do not attempt to drive high-sided vehicles"
msgstr "Не управляйте транспортом с большой высотой кузова"

#: lib/alerts.js:124
msgid "Secure or bring inside any outdoor furniture"
msgstr "Закрепите или уберите садовую мебель"

#: lib/alerts.js:125
msgid "Stay indoors away from windows"
msgstr "Оставайтесь в помещении, вдали от окон"

#: lib/alerts.js:126
msgid "Follow local emergency service guidance"
msgstr "Следуйте указаниям местных экстренных служб"

#: lib/alerts.js:135
msgid "💨 Strong Wind Warning"
msgstr "💨 Предупреждение о сильном ветре"

#: lib/alerts.js:137
msgid "Strong winds detected"
msgstr "Обнаружен сильный ветер"

#: lib/alerts.js:140
msgid ""
"Take care when walking or cycling — gusts may be stronger than the average"
msgstr ""
"Будьте осторожны пешком и на велосипеде — порывы могут быть сильнее средней "
"скорости"

#: lib/alerts.js:142
msgid "Secure loose outdoor items (bins, garden furniture, etc.)"
msgstr ""
"Закрепите незакреплённые предметы на улице (мусорные баки, садовая мебель и "
"т. п.)"

#: lib/alerts.js:143
msgid "Drive with extra caution, especially on exposed roads or bridges"
msgstr ""
"Ведите с особой осторожностью, особенно на открытых участках дорог и мостах"

#: lib/alerts.js:144
msgid "Cyclists and motorcyclists should be especially cautious"
msgstr "Велосипедистам и мотоциклистам стоит быть особенно осторожными"

#: lib/alerts.js:158
msgid "Seek shelter immediately in a sturdy building"
msgstr "Немедленно укройтесь в прочном здании"

#: lib/alerts.js:159
msgid "Avoid open fields, hilltops, and isolated trees"
msgstr "Избегайте открытых полей, вершин холмов и одиноких деревьев"

#: lib/alerts.js:160
msgid "Stay away from water, metal objects, and electrical equipment"
msgstr ""
"Держитесь подальше от воды, металлических предметов и электрооборудования"

#: lib/alerts.js:161
msgid "If outdoors and unable to shelter, crouch low — do not lie flat"
msgstr "Если на улице и укрыться нельзя, присядьте низко — не ложитесь"

#: lib/alerts.js:162
msgid "Avoid using corded phones or plugged-in devices"
msgstr "Не используйте проводные телефоны и устройства, включённые в сеть"

#: lib/alerts.js:163
msgid "Keep away from windows and doors"
msgstr "Держитесь подальше от окон и дверей"

#: lib/alerts.js:167
msgid "Follow official emergency service guidance"
msgstr "Следуйте официальным указаниям экстренных служб"

#: lib/alerts.js:168
msgid "Stay informed via local weather services"
msgstr "Следите за сообщениями местных метеослужб"

#: lib/alerts.js:169
msgid "Avoid non-essential travel"
msgstr "Избегайте поездок, если они не абсолютно необходимы"

#: lib/alerts.js:178
msgid "Avoid driving through flooded roads — even 30 cm can sweep a car away"
msgstr ""
"Не проезжайте по затопленным дорогам — даже 30 см могут смыть автомобиль"

#: lib/alerts.js:180
msgid "Be aware of localised flooding in low-lying areas"
msgstr "Остерегайтесь локальных подтоплений в низинах"

#: lib/alerts.js:181
msgid "Carry waterproof clothing if you must travel"
msgstr "Возьмите непромокаемую одежду, если поездка необходима"

#: lib/alerts.js:182
msgid "Check your local flood risk map"
msgstr "Изучите местную карту риска наводнений"

#: lib/alerts.js:188
msgid "Avoid travel unless absolutely necessary"
msgstr "Не путешествуйте, если это не абсолютно необходимо"

#: lib/alerts.js:189
msgid "If driving, carry a winter emergency kit (blanket, shovel, water)"
msgstr ""
"Если едете на машине, возьмите зимний аварийный набор (одеяло, лопата, вода)"

#: lib/alerts.js:190
msgid "Clear snow from paths and driveways carefully to avoid injury"
msgstr ""
"Осторожно убирайте снег с дорожек и подъездных путей, чтобы не получить "
"травму"

#: lib/alerts.js:191
msgid "Be aware of roof loading from heavy snow accumulation"
msgstr "Учитывайте нагрузку на крышу от скопления снега"

#: lib/alerts.js:195
msgid "Exercise caution outdoors"
msgstr "Будьте осторожны на улице"

#: lib/alerts.js:196
msgid "Stay informed via local weather forecasts"
msgstr "Следите за местными прогнозами погоды"

