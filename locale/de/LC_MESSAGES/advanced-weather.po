#: lib/alerts.js:37
msgid "⚠️ Severe Weather Alert"
msgstr "⚠️ Unwetterwarnung"

#: lib/alerts.js:46
msgid "⚠️ Weather Warning"
msgstr "⚠️ Wetterwarnung"

#: lib/alerts.js:66
msgid "🌡️ Extreme Heat Warning"
msgstr "🌡️ Hitzewarnung"

#: lib/alerts.js:68
msgid "Dangerously high temperature"
msgstr "Gefährlich hohe Temperatur"

#: lib/alerts.js:75
msgid "Stay indoors during peak hours (10 AM – 4 PM)"
msgstr "Während der Spitzenstunden (10–16 Uhr) drinnen bleiben"

#: lib/alerts.js:76
msgid "Drink water regularly — at least 2–3 litres per day"
msgstr "Regelmäßig Wasser trinken — mindestens 2–3 Liter pro Tag"

#: lib/alerts.js:77
msgid "Wear light, loose, light-coloured clothing"
msgstr "Leichte, lockere, helle Kleidung tragen"

#: lib/alerts.js:78
msgid "Never leave children or pets in parked vehicles"
msgstr "Kinder oder Haustiere nie in geparkten Fahrzeugen lassen"

#: lib/alerts.js:79
msgid "Check on elderly neighbours and relatives"
msgstr "Nach älteren Nachbarn und Angehörigen sehen"

#: lib/alerts.js:80
msgid "Use fans or air conditioning if available"
msgstr "Ventilatoren oder Klimaanlage nutzen, falls vorhanden"

#: lib/alerts.js:91
msgid "🥶 Extreme Cold Warning"
msgstr "🥶 Kältewarnung"

#: lib/alerts.js:93
msgid "Dangerously low temperature"
msgstr "Gefährlich niedrige Temperatur"

#: lib/alerts.js:100
msgid "Layer clothing: base layer, insulation, waterproof outer shell"
msgstr ""
"Zwiebelprinzip: Funktionsunterwäsche, Isolation, wasserdichte Außenschicht"

#: lib/alerts.js:101
msgid "Cover exposed skin — risk of frostbite within 30 minutes"
msgstr "Unbedeckte Haut schützen — Erfrierungsgefahr innerhalb von 30 Minuten"

#: lib/alerts.js:102
msgid "Keep emergency supplies in your vehicle if driving"
msgstr "Notfallausrüstung im Fahrzeug bereithalten"

#: lib/alerts.js:103
msgid "Check heating systems and carbon-monoxide detectors"
msgstr "Heizung und Kohlenmonoxid-Melder prüfen"

#: lib/alerts.js:104
msgid "Check on elderly and vulnerable people"
msgstr "Nach älteren und schutzbedürftigen Menschen sehen"

#: lib/alerts.js:105
msgid "Bring pets indoors"
msgstr "Haustiere ins Haus holen"

#: lib/alerts.js:117
msgid "🌀 Severe Storm Warning"
msgstr "🌀 Schwere Sturmwarnung"

#: lib/alerts.js:119
msgid "Dangerous wind speed"
msgstr "Gefährliche Windgeschwindigkeit"

#: lib/alerts.js:121
msgid "Avoid all unnecessary travel"
msgstr "Alle unnötigen Fahrten vermeiden"

#: lib/alerts.js:122
msgid "Stay away from trees, scaffolding, and signs"
msgstr "Von Bäumen, Gerüsten und Schildern fernhalten"

#: lib/alerts.js:123
msgid "Do not attempt to drive high-sided vehicles"
msgstr "Hochbauende Fahrzeuge nicht fahren"

#: lib/alerts.js:124
msgid "Secure or bring inside any outdoor furniture"
msgstr "Gartenmöbel sichern oder hineinholen"

#: lib/alerts.js:125
msgid "Stay indoors away from windows"
msgstr "Drinnen bleiben und von Fenstern fernhalten"

#: lib/alerts.js:126
msgid "Follow local emergency service guidance"
msgstr "Hinweisen der lokalen Rettungsdienste folgen"

#: lib/alerts.js:135
msgid "💨 Strong Wind Warning"
msgstr "💨 Warnung vor starkem Wind"

#: lib/alerts.js:137
msgid "Strong winds detected"
msgstr "Starke Winde erkannt"

#: lib/alerts.js:140
msgid ""
"Take care when walking or cycling — gusts may be stronger than the average"
msgstr ""
"Beim Gehen und Radfahren vorsichtig sein — Böen können stärker als der "
"Durchschnitt sein"

#: lib/alerts.js:142
msgid "Secure loose outdoor items (bins, garden furniture, etc.)"
msgstr "Lose Gegenstände im Freien sichern (Mülleimer, Gartenmöbel usw.)"

#: lib/alerts.js:143
msgid "Drive with extra caution, especially on exposed roads or bridges"
msgstr ""
"Mit erhöhter Vorsicht fahren, besonders auf offenen Straßen und Brücken"

#: lib/alerts.js:144
msgid "Cyclists and motorcyclists should be especially cautious"
msgstr "Radfahrende und Motorradfahrende sollten besonders vorsichtig sein"

#: lib/alerts.js:158
msgid "Seek shelter immediately in a sturdy building"
msgstr "Sofort Schutz in einem festen Gebäude suchen"

#: lib/alerts.js:159
msgid "Avoid open fields, hilltops, and isolated trees"
msgstr "Offene Felder, Hügelpuppen und einzelne Bäume meiden"

#: lib/alerts.js:160
msgid "Stay away from water, metal objects, and electrical equipment"
msgstr "Von Wasser, Metallgegenständen und Elektrogeräten fernhalten"

#: lib/alerts.js:161
msgid "If outdoors and unable to shelter, crouch low — do not lie flat"
msgstr "Draußen ohne Deckung klein hocken — nicht flach hinlegen"

#: lib/alerts.js:162
msgid "Avoid using corded phones or plugged-in devices"
msgstr ""
"Keine Schnurtelefone oder am Stromnetz angeschlossenen Geräte benutzen"

#: lib/alerts.js:163
msgid "Keep away from windows and doors"
msgstr "Von Fenstern und Türen fernhalten"

#: lib/alerts.js:167
msgid "Follow official emergency service guidance"
msgstr "Hinweisen der offiziellen Rettungsdienste folgen"

#: lib/alerts.js:168
msgid "Stay informed via local weather services"
msgstr "Über lokale Wetterdienste informiert bleiben"

#: lib/alerts.js:169
msgid "Avoid non-essential travel"
msgstr "Nicht notwendige Fahrten vermeiden"

#: lib/alerts.js:178
msgid "Avoid driving through flooded roads — even 30 cm can sweep a car away"
msgstr ""
"Nicht durch überflutete Straßen fahren — schon 30 cm können ein Auto "
"fortspülen"

#: lib/alerts.js:180
msgid "Be aware of localised flooding in low-lying areas"
msgstr "Mit lokalen Überschwemmungen in tiefliegenden Gebieten rechnen"

#: lib/alerts.js:181
msgid "Carry waterproof clothing if you must travel"
msgstr "Falls Reisen nötig ist, wasserdichte Kleidung mitnehmen"

#: lib/alerts.js:182
msgid "Check your local flood risk map"
msgstr "Lokalen Hochwassergefahrenplan prüfen"

#: lib/alerts.js:188
msgid "Avoid travel unless absolutely necessary"
msgstr "Reisen nur wenn unbedingt nötig"

#: lib/alerts.js:189
msgid "If driving, carry a winter emergency kit (blanket, shovel, water)"
msgstr "Bei Fahrten Winter-Notfallset mitführen (Decke, Schaufel, Wasser)"

#: lib/alerts.js:190
msgid "Clear snow from paths and driveways carefully to avoid injury"
msgstr ""
"Wege und Einfahrten vorsichtig von Schnee befreien, um Verletzungen zu "
"vermeiden"

#: lib/alerts.js:191
msgid "Be aware of roof loading from heavy snow accumulation"
msgstr "Dachbelastung durch hohe Schneemengen beachten"

#: lib/alerts.js:195
msgid "Exercise caution outdoors"
msgstr "Draußen vorsichtig sein"

#: lib/alerts.js:196
msgid "Stay informed via local weather forecasts"
msgstr "Über lokale Wettervorhersagen informiert bleiben"

