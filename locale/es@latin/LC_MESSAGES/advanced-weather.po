#: lib/alerts.js:37
msgid "⚠️ Severe Weather Alert"
msgstr "⚠️ Alerta de tiempo severo"

#: lib/alerts.js:46
msgid "⚠️ Weather Warning"
msgstr "⚠️ Aviso meteorológico"

#: lib/alerts.js:66
msgid "🌡️ Extreme Heat Warning"
msgstr "🌡️ Aviso de calor extremo"

#: lib/alerts.js:68
msgid "Dangerously high temperature"
msgstr "Temperatura peligrosamente alta"

#: lib/alerts.js:75
msgid "Stay indoors during peak hours (10 AM – 4 PM)"
msgstr "Permanezca en interiores en las horas punta (10:00–16:00)"

#: lib/alerts.js:76
msgid "Drink water regularly — at least 2–3 litres per day"
msgstr "Beba agua con regularidad — al menos 2–3 litros al día"

#: lib/alerts.js:77
msgid "Wear light, loose, light-coloured clothing"
msgstr "Lleve ropa ligera, holgada y de colores claros"

#: lib/alerts.js:78
msgid "Never leave children or pets in parked vehicles"
msgstr "No deje nunca a niños ni mascotas en vehículos estacionados"

#: lib/alerts.js:79
msgid "Check on elderly neighbours and relatives"
msgstr "Revise el estado de vecinos y familiares mayores"

#: lib/alerts.js:80
msgid "Use fans or air conditioning if available"
msgstr "Use ventiladores o aire acondicionado si dispone de ellos"

#: lib/alerts.js:91
msgid "🥶 Extreme Cold Warning"
msgstr "🥶 Aviso de frío extremo"

#: lib/alerts.js:93
msgid "Dangerously low temperature"
msgstr "Temperatura peligrosamente baja"

#: lib/alerts.js:100
msgid "Layer clothing: base layer, insulation, waterproof outer shell"
msgstr "Vístase por capas: capa base, aislamiento, capa exterior impermeable"

#: lib/alerts.js:101
msgid "Cover exposed skin — risk of frostbite within 30 minutes"
msgstr "Cubra la piel expuesta — riesgo de congelación en 30 minutos"

#: lib/alerts.js:102
msgid "Keep emergency supplies in your vehicle if driving"
msgstr "Lleve provisiones de emergencia en el vehículo si conduce"

#: lib/alerts.js:103
msgid "Check heating systems and carbon-monoxide detectors"
msgstr "Revise la calefacción y los detectores de monóxido de carbono"

#: lib/alerts.js:104
msgid "Check on elderly and vulnerable people"
msgstr "Revise el estado de las personas mayores y vulnerables"

#: lib/alerts.js:105
msgid "Bring pets indoors"
msgstr "Meta a las mascotas en casa"

#: lib/alerts.js:117
msgid "🌀 Severe Storm Warning"
msgstr "🌀 Aviso de tormenta severa"

#: lib/alerts.js:119
msgid "Dangerous wind speed"
msgstr "Velocidad de viento peligrosa"

#: lib/alerts.js:121
msgid "Avoid all unnecessary travel"
msgstr "Evite todos los desplazamientos innecesarios"

#: lib/alerts.js:122
msgid "Stay away from trees, scaffolding, and signs"
msgstr "Aléjese de árboles, andamios y señales"

#: lib/alerts.js:123
msgid "Do not attempt to drive high-sided vehicles"
msgstr "No intente conducir vehículos de gran altura"

#: lib/alerts.js:124
msgid "Secure or bring inside any outdoor furniture"
msgstr "Asegure o meta dentro los muebles de exterior"

#: lib/alerts.js:125
msgid "Stay indoors away from windows"
msgstr "Permanezca en interiores, lejos de las ventanas"

#: lib/alerts.js:126
msgid "Follow local emergency service guidance"
msgstr "Siga las indicaciones de los servicios de emergencia locales"

#: lib/alerts.js:135
msgid "💨 Strong Wind Warning"
msgstr "💨 Aviso de viento fuerte"

#: lib/alerts.js:137
msgid "Strong winds detected"
msgstr "Vientos fuertes detectados"

#: lib/alerts.js:140
msgid ""
"Take care when walking or cycling — gusts may be stronger than the average"
msgstr ""
"Tenga cuidado al caminar o en bicicleta — las ráfagas pueden superar la "
"media"

#: lib/alerts.js:142
msgid "Secure loose outdoor items (bins, garden furniture, etc.)"
msgstr ""
"Asegure los objetos sueltos del exterior (basuras, muebles de jardín, etc.)"

#: lib/alerts.js:143
msgid "Drive with extra caution, especially on exposed roads or bridges"
msgstr ""
"Conduzca con precaución extra, sobre todo en carreteras expuestas y puentes"

#: lib/alerts.js:144
msgid "Cyclists and motorcyclists should be especially cautious"
msgstr "Ciclistas y motoristas deben extremar la precaución"

#: lib/alerts.js:158
msgid "Seek shelter immediately in a sturdy building"
msgstr "Refúgiese de inmediato en un edificio resistente"

#: lib/alerts.js:159
msgid "Avoid open fields, hilltops, and isolated trees"
msgstr "Evite campos abiertos, cumbres y árboles aislados"

#: lib/alerts.js:160
msgid "Stay away from water, metal objects, and electrical equipment"
msgstr "Aléjese del agua, los objetos metálicos y los equipos eléctricos"

#: lib/alerts.js:161
msgid "If outdoors and unable to shelter, crouch low — do not lie flat"
msgstr "Si está al aire libre sin refugio, agáchese — no se tumbe"

#: lib/alerts.js:162
msgid "Avoid using corded phones or plugged-in devices"
msgstr ""
"Evite usar teléfonos con cable o dispositivos conectados a la corriente"

#: lib/alerts.js:163
msgid "Keep away from windows and doors"
msgstr "Aléjese de ventanas y puertas"

#: lib/alerts.js:167
msgid "Follow official emergency service guidance"
msgstr "Siga las indicaciones oficiales de los servicios de emergencia"

#: lib/alerts.js:168
msgid "Stay informed via local weather services"
msgstr "Manténgase informado con los servicios meteorológicos locales"

#: lib/alerts.js:169
msgid "Avoid non-essential travel"
msgstr "Evite los desplazamientos no esenciales"

#: lib/alerts.js:178
msgid "Avoid driving through flooded roads — even 30 cm can sweep a car away"
msgstr "No cruce carreteras inundadas — 30 cm bastan para arrastrar un coche"

#: lib/alerts.js:180
msgid "Be aware of localised flooding in low-lying areas"
msgstr "Tenga en cuenta las inundaciones localizadas en zonas bajas"

#: lib/alerts.js:181
msgid "Carry waterproof clothing if you must travel"
msgstr "Lleve ropa impermeable si debe viajar"

#: lib/alerts.js:182
msgid "Check your local flood risk map"
msgstr "Consulte el mapa local de riesgo de inundación"

#: lib/alerts.js:188
msgid "Avoid travel unless absolutely necessary"
msgstr "Evite viajar salvo que sea imprescindible"

#: lib/alerts.js:189
msgid "If driving, carry a winter emergency kit (blanket, shovel, water)"
msgstr "Si conduce, lleve un kit de emergencia invernal (manta, pala, agua)"

#: lib/alerts.js:190
msgid "Clear snow from paths and driveways carefully to avoid injury"
msgstr ""
"Retire la nieve de caminos y entradas con cuidado para evitar lesiones"

#: lib/alerts.js:191
msgid "Be aware of roof loading from heavy snow accumulation"
msgstr "Tenga en cuenta el peso de la nieve acumulada en el tejado"

#: lib/alerts.js:195
msgid "Exercise caution outdoors"
msgstr "Tenga precaución al aire libre"

#: lib/alerts.js:196
msgid "Stay informed via local weather forecasts"
msgstr "Manténgase informado con las previsiones meteorológicas locales"

