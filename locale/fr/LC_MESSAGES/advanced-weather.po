#: lib/alerts.js:37
msgid "⚠️ Severe Weather Alert"
msgstr "⚠️ Alerte météo sévère"

#: lib/alerts.js:46
msgid "⚠️ Weather Warning"
msgstr "⚠️ Alerte météo"

#: lib/alerts.js:66
msgid "🌡️ Extreme Heat Warning"
msgstr "🌡️ Alerte canicule"

#: lib/alerts.js:68
msgid "Dangerously high temperature"
msgstr "Température dangereusement élevée"

#: lib/alerts.js:75
msgid "Stay indoors during peak hours (10 AM – 4 PM)"
msgstr "Restez à l'intérieur pendant les heures de pointe (10 h – 16 h)"

#: lib/alerts.js:76
msgid "Drink water regularly — at least 2–3 litres per day"
msgstr "Buvez régulièrement — au moins 2 à 3 litres par jour"

#: lib/alerts.js:77
msgid "Wear light, loose, light-coloured clothing"
msgstr "Portez des vêtements légers, amples et clairs"

#: lib/alerts.js:78
msgid "Never leave children or pets in parked vehicles"
msgstr "Ne laissez jamais d'enfants ni d'animaux dans un véhicule garé"

#: lib/alerts.js:79
msgid "Check on elderly neighbours and relatives"
msgstr "Prenez des nouvelles des voisins et proches âgés"

#: lib/alerts.js:80
msgid "Use fans or air conditioning if available"
msgstr "Utilisez des ventilateurs ou la climatisation si possible"

#: lib/alerts.js:91
msgid "🥶 Extreme Cold Warning"
msgstr "🥶 Alerte grand froid"

#: lib/alerts.js:93
msgid "Dangerously low temperature"
msgstr "Température dangereusement basse"

#: lib/alerts.js:100
msgid "Layer clothing: base layer, insulation, waterproof outer shell"
msgstr "Superposez les couches : sous-couche, isolation, veste imperméable"

#: lib/alerts.js:101
msgid "Cover exposed skin — risk of frostbite within 30 minutes"
msgstr "Couvrez la peau exposée — risque d'engelures en moins de 30 minutes"

#: lib/alerts.js:102
msgid "Keep emergency supplies in your vehicle if driving"
msgstr "Gardez du matériel d'urgence dans le véhicule"

#: lib/alerts.js:103
msgid "Check heating systems and carbon-monoxide detectors"
msgstr "Vérifiez le chauffage et les détecteurs de monoxyde de carbone"

#: lib/alerts.js:104
msgid "Check on elderly and vulnerable people"
msgstr "Prenez des nouvelles des personnes âgées et vulnérables"

#: lib/alerts.js:105
msgid "Bring pets indoors"
msgstr "Rentrez les animaux de compagnie"

#: lib/alerts.js:117
msgid "🌀 Severe Storm Warning"
msgstr "🌀 Alerte tempête sévère"

#: lib/alerts.js:119
msgid "Dangerous wind speed"
msgstr "Vitesse de vent dangereuse"

#: lib/alerts.js:121
msgid "Avoid all unnecessary travel"
msgstr "Évitez tous les déplacements inutiles"

#: lib/alerts.js:122
msgid "Stay away from trees, scaffolding, and signs"
msgstr "Éloignez-vous des arbres, échafaudages et panneaux"

#: lib/alerts.js:123
msgid "Do not attempt to drive high-sided vehicles"
msgstr "Ne pas conduire de véhicules hauts"

#: lib/alerts.js:124
msgid "Secure or bring inside any outdoor furniture"
msgstr "Fixez ou rentrez le mobilier de jardin"

#: lib/alerts.js:125
msgid "Stay indoors away from windows"
msgstr "Restez à l'intérieur, à l'écart des fenêtres"

#: lib/alerts.js:126
msgid "Follow local emergency service guidance"
msgstr "Suivez les consignes des services de secours locaux"

#: lib/alerts.js:135
msgid "💨 Strong Wind Warning"
msgstr "💨 Alerte vent fort"

#: lib/alerts.js:137
msgid "Strong winds detected"
msgstr "Vents forts détectés"

#: lib/alerts.js:140
msgid ""
"Take care when walking or cycling — gusts may be stronger than the average"
msgstr ""
"Soyez prudent à pied ou à vélo — les rafales peuvent dépasser la moyenne"

#: lib/alerts.js:142
msgid "Secure loose outdoor items (bins, garden furniture, etc.)"
msgstr ""
"Fixez les objets extérieurs non fixés (poubelles, mobilier de jardin, etc.)"

#: lib/alerts.js:143
msgid "Drive with extra caution, especially on exposed roads or bridges"
msgstr ""
"Conduisez avec une prudence accrue, surtout sur les routes exposées et les "
"ponts"

#: lib/alerts.js:144
msgid "Cyclists and motorcyclists should be especially cautious"
msgstr "Les cyclistes et les motards doivent redoubler de prudence"

#: lib/alerts.js:158
msgid "Seek shelter immediately in a sturdy building"
msgstr "Refugiez-vous immédiatement dans un bâtiment solide"

#: lib/alerts.js:159
msgid "Avoid open fields, hilltops, and isolated trees"
msgstr "Évitez les champs ouverts, les sommets et les arbres isolés"

#: lib/alerts.js:160
msgid "Stay away from water, metal objects, and electrical equipment"
msgstr ""
"Éloignez-vous de l'eau, des objets métalliques et des appareils électriques"

#: lib/alerts.js:161
msgid "If outdoors and unable to shelter, crouch low — do not lie flat"
msgstr ""
"Dehors, sans abri possible, accroupissez-vous bas — ne vous allongez pas"

#: lib/alerts.js:162
msgid "Avoid using corded phones or plugged-in devices"
msgstr "Évitez les téléphones fixes et les appareils branchés au secteur"

#: lib/alerts.js:163
msgid "Keep away from windows and doors"
msgstr "Éloignez-vous des fenêtres et des portes"

#: lib/alerts.js:167
msgid "Follow official emergency service guidance"
msgstr "Suivez les consignes officielles des services de secours"

#: lib/alerts.js:168
msgid "Stay informed via local weather services"
msgstr "Restez informé grâce aux services météo locaux"

#: lib/alerts.js:169
msgid "Avoid non-essential travel"
msgstr "Évitez les déplacements non essentiels"

#: lib/alerts.js:178
msgid "Avoid driving through flooded roads — even 30 cm can sweep a car away"
msgstr ""
"Ne pas traverser de routes inondées — 30 cm suffisent à emporter une voiture"

#: lib/alerts.js:180
msgid "Be aware of localised flooding in low-lying areas"
msgstr "Risque d'inondations localisées dans les zones basses"

#: lib/alerts.js:181
msgid "Carry waterproof clothing if you must travel"
msgstr "Emportez des vêtements imperméables si vous devez voyager"

#: lib/alerts.js:182
msgid "Check your local flood risk map"
msgstr "Consultez la carte locale des risques d'inondation"

#: lib/alerts.js:188
msgid "Avoid travel unless absolutely necessary"
msgstr "Évitez de voyager sauf nécessité absolue"

#: lib/alerts.js:189
msgid "If driving, carry a winter emergency kit (blanket, shovel, water)"
msgstr ""
"En cas de trajet, emportez une trousse d'urgence hivernale (couverture, "
"pelle, eau)"

#: lib/alerts.js:190
msgid "Clear snow from paths and driveways carefully to avoid injury"
msgstr "Déneigez prudemment les allées et entrées pour éviter les blessures"

#: lib/alerts.js:191
msgid "Be aware of roof loading from heavy snow accumulation"
msgstr "Attention à la charge du toit due à l'accumulation de neige"

#: lib/alerts.js:195
msgid "Exercise caution outdoors"
msgstr "Soyez prudent à l'extérieur"

#: lib/alerts.js:196
msgid "Stay informed via local weather forecasts"
msgstr "Restez informé grâce aux prévisions météo locales"

