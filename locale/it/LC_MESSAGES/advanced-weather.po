#: lib/alerts.js:37
msgid "⚠️ Severe Weather Alert"
msgstr "⚠️ Avviso meteo severo"

#: lib/alerts.js:46
msgid "⚠️ Weather Warning"
msgstr "⚠️ Allerta meteo"

#: lib/alerts.js:66
msgid "🌡️ Extreme Heat Warning"
msgstr "🌡️ Allerta caldo estremo"

#: lib/alerts.js:68
msgid "Dangerously high temperature"
msgstr "Temperatura pericolosamente alta"

#: lib/alerts.js:75
msgid "Stay indoors during peak hours (10 AM – 4 PM)"
msgstr "Resta in casa nelle ore di punta (10–16)"

#: lib/alerts.js:76
msgid "Drink water regularly — at least 2–3 litres per day"
msgstr "Bevi acqua regolarmente — almeno 2–3 litri al giorno"

#: lib/alerts.js:77
msgid "Wear light, loose, light-coloured clothing"
msgstr "Indossa abiti leggeri, larghi e chiari"

#: lib/alerts.js:78
msgid "Never leave children or pets in parked vehicles"
msgstr "Non lasciare mai bambini o animali in veicoli in sosta"

#: lib/alerts.js:79
msgid "Check on elderly neighbours and relatives"
msgstr "Controlla i vicini e i parenti anziani"

#: lib/alerts.js:80
msgid "Use fans or air conditioning if available"
msgstr "Usa ventilatori o aria condizionata se disponibili"

#: lib/alerts.js:91
msgid "🥶 Extreme Cold Warning"
msgstr "🥶 Allerta freddo estremo"

#: lib/alerts.js:93
msgid "Dangerously low temperature"
msgstr "Temperatura pericolosamente bassa"

#: lib/alerts.js:100
msgid "Layer clothing: base layer, insulation, waterproof outer shell"
msgstr "Vesti a strati: strato base, isolamento, guscio impermeabile"

#: lib/alerts.js:101
msgid "Cover exposed skin — risk of frostbite within 30 minutes"
msgstr "Copri la pelle esposta — rischio di congelamento entro 30 minuti"

#: lib/alerts.js:102
msgid "Keep emergency supplies in your vehicle if driving"
msgstr "Tieni le scorte di emergenza in auto se guidi"

#: lib/alerts.js:103
msgid "Check heating systems and carbon-monoxide detectors"
msgstr ""
"Controlla l'impianto di riscaldamento e i rilevatori di monossido di "
"carbonio"

#: lib/alerts.js:104
msgid "Check on elderly and vulnerable people"
msgstr "Controlla le persone anziane e vulnerabili"

#: lib/alerts.js:105
msgid "Bring pets indoors"
msgstr "Porta gli animali domestici in casa"

#: lib/alerts.js:117
msgid "🌀 Severe Storm Warning"
msgstr "🌀 Allerta tempesta grave"

#: lib/alerts.js:119
msgid "Dangerous wind speed"
msgstr "Velocità del vento pericolosa"

#: lib/alerts.js:121
msgid "Avoid all unnecessary travel"
msgstr "Evita tutti gli spostamenti non necessari"

#: lib/alerts.js:122
msgid "Stay away from trees, scaffolding, and signs"
msgstr "Stai lontano da alberi, impalcature e cartelli"

#: lib/alerts.js:123
msgid "Do not attempt to drive high-sided vehicles"
msgstr "Non provare a guidare veicoli alti"

#: lib/alerts.js:124
msgid "Secure or bring inside any outdoor furniture"
msgstr "Metti in sicurezza o ritira i mobili da esterno"

#: lib/alerts.js:125
msgid "Stay indoors away from windows"
msgstr "Resta in casa lontano dalle finestre"

#: lib/alerts.js:126
msgid "Follow local emergency service guidance"
msgstr "Segui le indicazioni dei soccorsi locali"

#: lib/alerts.js:135
msgid "💨 Strong Wind Warning"
msgstr "💨 Allerta vento forte"

#: lib/alerts.js:137
msgid "Strong winds detected"
msgstr "Venti forti rilevati"

#: lib/alerts.js:140
msgid ""
"Take care when walking or cycling — gusts may be stronger than the average"
msgstr "Attenzione a piedi o in bici — le raffiche possono superare la media"

#: lib/alerts.js:142
msgid "Secure loose outdoor items (bins, garden furniture, etc.)"
msgstr ""
"Assicura gli oggetti esterni mobili (bidoni, mobili da giardino, ecc.)"

#: lib/alerts.js:143
msgid "Drive with extra caution, especially on exposed roads or bridges"
msgstr "Guida con prudenza, soprattutto su strade esposte e ponti"

#: lib/alerts.js:144
msgid "Cyclists and motorcyclists should be especially cautious"
msgstr "Ciclisti e motociclisti devono prestare particolare attenzione"

#: lib/alerts.js:158
msgid "Seek shelter immediately in a sturdy building"
msgstr "Cerca subito riparo in un edificio solido"

#: lib/alerts.js:159
msgid "Avoid open fields, hilltops, and isolated trees"
msgstr "Evita campi aperti, culmini e alberi isolati"

#: lib/alerts.js:160
msgid "Stay away from water, metal objects, and electrical equipment"
msgstr "Stai lontano da acqua, oggetti metallici e apparecchi elettrici"

#: lib/alerts.js:161
msgid "If outdoors and unable to shelter, crouch low — do not lie flat"
msgstr "Se sei all'aperto senza riparo, accovacciati basso — non sdraiarti"

#: lib/alerts.js:162
msgid "Avoid using corded phones or plugged-in devices"
msgstr "Evita telefoni con filo e dispositivi collegati alla corrente"

#: lib/alerts.js:163
msgid "Keep away from windows and doors"
msgstr "Stai lontano da finestre e porte"

#: lib/alerts.js:167
msgid "Follow official emergency service guidance"
msgstr "Segui le indicazioni ufficiali dei soccorsi"

#: lib/alerts.js:168
msgid "Stay informed via local weather services"
msgstr "Resta informato tramite i servizi meteo locali"

#: lib/alerts.js:169
msgid "Avoid non-essential travel"
msgstr "Evita gli spostamenti non essenziali"

#: lib/alerts.js:178
msgid "Avoid driving through flooded roads — even 30 cm can sweep a car away"
msgstr ""
"Non attraversare strade allagate — anche 30 cm possono trascinare via "
"un'auto"

#: lib/alerts.js:180
msgid "Be aware of localised flooding in low-lying areas"
msgstr "Attenzione agli allagamenti localizzati nelle zone basse"

#: lib/alerts.js:181
msgid "Carry waterproof clothing if you must travel"
msgstr "Porta abbigliamento impermeabile se devi viaggiare"

#: lib/alerts.js:182
msgid "Check your local flood risk map"
msgstr "Consulta la mappa locale del rischio idrogeologico"

#: lib/alerts.js:188
msgid "Avoid travel unless absolutely necessary"
msgstr "Evita gli spostamenti se non strettamente necessari"

#: lib/alerts.js:189
msgid "If driving, carry a winter emergency kit (blanket, shovel, water)"
msgstr "Se guidi, tieni un kit di emergenza invernale (coperta, pala, acqua)"

#: lib/alerts.js:190
msgid "Clear snow from paths and driveways carefully to avoid injury"
msgstr ""
"Libera con prudenza sentieri e vialetti dalla neve per evitare infortuni"

#: lib/alerts.js:191
msgid "Be aware of roof loading from heavy snow accumulation"
msgstr "Attenzione al carico del tetto per l'accumulo di neve"

#: lib/alerts.js:195
msgid "Exercise caution outdoors"
msgstr "Presta attenzione all'aperto"

#: lib/alerts.js:196
msgid "Stay informed via local weather forecasts"
msgstr "Resta informato tramite le previsioni meteo locali"

