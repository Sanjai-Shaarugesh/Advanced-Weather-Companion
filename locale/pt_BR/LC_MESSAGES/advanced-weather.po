#: lib/alerts.js:37
msgid "⚠️ Severe Weather Alert"
msgstr "⚠️ Alerta de tempo severo"

#: lib/alerts.js:46
msgid "⚠️ Weather Warning"
msgstr "⚠️ Aviso meteorológico"

#: lib/alerts.js:66
msgid "🌡️ Extreme Heat Warning"
msgstr "🌡️ Aviso de calor extremo"

#: lib/alerts.js:68
msgid "Dangerously high temperature"
msgstr "Temperatura perigosamente alta"

#: lib/alerts.js:75
msgid "Stay indoors during peak hours (10 AM – 4 PM)"
msgstr "Fique em ambiente fechado nos horários de pico (10h–16h)"

#: lib/alerts.js:76
msgid "Drink water regularly — at least 2–3 litres per day"
msgstr "Beba água com regularidade — pelo menos 2 a 3 litros por dia"

#: lib/alerts.js:77
msgid "Wear light, loose, light-coloured clothing"
msgstr "Use roupas leves, largas e de cores claras"

#: lib/alerts.js:78
msgid "Never leave children or pets in parked vehicles"
msgstr "Nunca deixe crianças ou animais em veículos estacionados"

#: lib/alerts.js:79
msgid "Check on elderly neighbours and relatives"
msgstr "Verifique vizinhos e parentes idosos"

#: lib/alerts.js:80
msgid "Use fans or air conditioning if available"
msgstr "Use ventiladores ou ar-condicionado se disponível"

#: lib/alerts.js:91
msgid "🥶 Extreme Cold Warning"
msgstr "🥶 Aviso de frio extremo"

#: lib/alerts.js:93
msgid "Dangerously low temperature"
msgstr "Temperatura perigosamente baixa"

#: lib/alerts.js:100
msgid "Layer clothing: base layer, insulation, waterproof outer shell"
msgstr "Vista-se em camadas: camada base, isolamento, casaco impermeável"

#: lib/alerts.js:101
msgid "Cover exposed skin — risk of frostbite within 30 minutes"
msgstr "Cubra a pele exposta — risco de congelamento em 30 minutos"

#: lib/alerts.js:102
msgid "Keep emergency supplies in your vehicle if driving"
msgstr "Mantenha suprimentos de emergência no veículo se for dirigir"

#: lib/alerts.js:103
msgid "Check heating systems and carbon-monoxide detectors"
msgstr "Verifique o aquecimento e os detectores de monóxido de carbono"

#: lib/alerts.js:104
msgid "Check on elderly and vulnerable people"
msgstr "Verifique as pessoas idosas e vulneráveis"

#: lib/alerts.js:105
msgid "Bring pets indoors"
msgstr "Traga os animais de estimação para dentro de casa"

#: lib/alerts.js:117
msgid "🌀 Severe Storm Warning"
msgstr "🌀 Aviso de tempestade severa"

#: lib/alerts.js:119
msgid "Dangerous wind speed"
msgstr "Velocidade do vento perigosa"

#: lib/alerts.js:121
msgid "Avoid all unnecessary travel"
msgstr "Evite todos os deslocamentos desnecessários"

#: lib/alerts.js:122
msgid "Stay away from trees, scaffolding, and signs"
msgstr "Fique longe de árvores, andaimes e placas"

#: lib/alerts.js:123
msgid "Do not attempt to drive high-sided vehicles"
msgstr "Não tente dirigir veículos altos"

#: lib/alerts.js:124
msgid "Secure or bring inside any outdoor furniture"
msgstr "Prenda ou recolha os móveis de exterior"

#: lib/alerts.js:125
msgid "Stay indoors away from windows"
msgstr "Fique em ambiente fechado, longe das janelas"

#: lib/alerts.js:126
msgid "Follow local emergency service guidance"
msgstr "Siga as orientações dos serviços de emergência locais"

#: lib/alerts.js:135
msgid "💨 Strong Wind Warning"
msgstr "💨 Aviso de vento forte"

#: lib/alerts.js:137
msgid "Strong winds detected"
msgstr "Ventos fortes detectados"

#: lib/alerts.js:140
msgid ""
"Take care when walking or cycling — gusts may be stronger than the average"
msgstr "Cuidado ao caminhar ou pedalar — as rajadas podem superar a média"

#: lib/alerts.js:142
msgid "Secure loose outdoor items (bins, garden furniture, etc.)"
msgstr ""
"Prenda os objetos soltos do lado de fora (lixeiras, móveis de jardim etc.)"

#: lib/alerts.js:143
msgid "Drive with extra caution, especially on exposed roads or bridges"
msgstr "Dirija com cuidado extra, especialmente em estradas expostas e pontes"

#: lib/alerts.js:144
msgid "Cyclists and motorcyclists should be especially cautious"
msgstr "Ciclistas e motociclistas devem ter cuidado redobrado"

#: lib/alerts.js:158
msgid "Seek shelter immediately in a sturdy building"
msgstr "Procure abrigo imediatamente em um prédio resistente"

#: lib/alerts.js:159
msgid "Avoid open fields, hilltops, and isolated trees"
msgstr "Evite campos abertos, topos de colina e árvores isoladas"

#: lib/alerts.js:160
msgid "Stay away from water, metal objects, and electrical equipment"
msgstr "Fique longe de água, objetos metálicos e equipamentos elétricos"

#: lib/alerts.js:161
msgid "If outdoors and unable to shelter, crouch low — do not lie flat"
msgstr "Se estiver ao ar livre sem abrigo, agache-se baixo — não se deite"

#: lib/alerts.js:162
msgid "Avoid using corded phones or plugged-in devices"
msgstr "Evite telefones com fio e dispositivos ligados à tomada"

#: lib/alerts.js:163
msgid "Keep away from windows and doors"
msgstr "Mantenha-se longe de janelas e portas"

#: lib/alerts.js:167
msgid "Follow official emergency service guidance"
msgstr "Siga as orientações oficiais dos serviços de emergência"

#: lib/alerts.js:168
msgid "Stay informed via local weather services"
msgstr "Mantenha-se informado pelos serviços meteorológicos locais"

#: lib/alerts.js:169
msgid "Avoid non-essential travel"
msgstr "Evite deslocamentos não essenciais"

#: lib/alerts.js:178
msgid "Avoid driving through flooded roads — even 30 cm can sweep a car away"
msgstr "Não atravesse estradas alagadas — 30 cm bastam para arrastar um carro"

#: lib/alerts.js:180
msgid "Be aware of localised flooding in low-lying areas"
msgstr "Fique atento a alagamentos localizados em áreas baixas"

#: lib/alerts.js:181
msgid "Carry waterproof clothing if you must travel"
msgstr "Leve roupa impermeável se precisar viajar"

#: lib/alerts.js:182
msgid "Check your local flood risk map"
msgstr "Consulte o mapa local de risco de enchentes"

#: lib/alerts.js:188
msgid "Avoid travel unless absolutely necessary"
msgstr "Evite viagens, a menos que sejam absolutamente necessárias"

#: lib/alerts.js:189
msgid "If driving, carry a winter emergency kit (blanket, shovel, water)"
msgstr ""
"Se for dirigir, leve um kit de emergência de inverno (cobertor, pá, água)"

#: lib/alerts.js:190
msgid "Clear snow from paths and driveways carefully to avoid injury"
msgstr "Retire a neve de caminhos e entradas com cuidado para evitar lesões"

#: lib/alerts.js:191
msgid "Be aware of roof loading from heavy snow accumulation"
msgstr "Fique atento ao peso da neve acumulada no telhado"

#: lib/alerts.js:195
msgid "Exercise caution outdoors"
msgstr "Tenha cuidado ao ar livre"

#: lib/alerts.js:196
msgid "Stay informed via local weather forecasts"
msgstr "Mantenha-se informado pelas previsões meteorológicas locais"

