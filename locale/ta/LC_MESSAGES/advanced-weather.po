msgstr "சரிபார்க்கிறது…"

#: lib/panelMenu.js:327 lib/panelMenu.js:455 lib/panelMenu.js:462
msgid "Last Update"
msgstr "கடைசி புதுப்பிப்பு"

#: lib/panelMenu.js:327 lib/panelMenu.js:462
msgid "Never"
msgstr "ஒருபோதும் இல்லை"

#: lib/panelMenu.js:347
msgid "Available Providers"
msgstr "கிடைக்கக்கூடிய வழங்குநர்கள்"

#: lib/panelMenu.js:375
msgid "Custom Provider"
msgstr "தனிப்பயன் வழங்குநர்"

#: lib/panelMenu.js:428
msgid "Free"
msgstr "இலவசம்"

#: lib/panelMenu.js:434
msgid "Working"
msgstr "செயல்படுகிறது"

#: lib/panelMenu.js:436
msgid "Connection Timeout"
msgstr "இணைப்பு நேர முடிவு"

