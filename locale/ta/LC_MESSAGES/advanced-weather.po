msgstr "MIT உரிமம் - இலவச திறந்த மூல மென்பொருள்"

#: prefs.js:1277
msgid "Weather Data Sources"
msgstr "வானிலை தரவு மூலங்கள்"

#: prefs.js:1278
msgid "Open-Meteo, Meteosource, Wttr.in - Free weather APIs"
