#: prefs.js:1382
msgid ""
"Invalid coordinates. Latitude must be between -90 and 90, longitude between "
"-180 and 180."
msgstr ""
"தவறான ஆயத்தொலிருகள். அட்சரேகை -90 முதல் 90 வரையிலும், தீர்க்கரேகை -180 முதல்"
" 180 வரையிலும் இருக்க வேண்டும்."

#: prefs.js:1395
msgid "Unable to connect to location service. Check your internet connection."
msgstr ""
"இருப்பிட சேவையுடன் இணைக்க முடியவில்லை. உங்கள் இணைப்பைச் சரிபார்க்கவும்."

#: prefs.js:1397
msgid "Invalid response from location service. Please try again."
msgstr ""
"இருப்பிட சேவையிலிருந்து தவறான பதில் கிடைத்தது. மீண்டும் முயற்சிக்கவும்."

#: prefs.js:1399
msgid "Search timed out. Please try again."
msgstr "தேடல் நேர முடிவு. மீண்டும் முயற்சிக்கவும்."

#: prefs.js:1516 prefs.js:1554
msgid "Select this location"
msgstr "இந்த இருப்பிடத்தை தேர்ந்தெடு"

#: prefs.js:1573
msgid "Location updated successfully"
msgstr "இருப்பிடம் வெற்றிகரமாகப் புதுப்பிக்கப்பட்டது"

#: prefs.js:1576
msgid "Failed to save location. Please try again."
msgstr "இருப்பிடத்தைச் சேமிக்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."

#: prefs.js:1583
msgid "No Results Found"
msgstr "முடிவுகள் எதுவும் இல்லை"

#: prefs.js:1584
msgid "Try a different search term or check your spelling"
msgstr ""
"வேறு தேடல் சொல்லை முயற்சிக்கவும் அல்லது உங்கள் எழுத்துப்பிழையை "
"சரிபார்க்கவும்"

#: prefs.js:1618
msgid "Search Error"
msgstr "தேடல் பிழை"

#: prefs.js:1644 prefs.js:1662
msgid "🌍 Auto Detection Enabled"
msgstr "🌍 தானியங்கி கண்டறிதல் இயக்கப்பட்டது"

#: prefs.js:1649 prefs.js:1667
