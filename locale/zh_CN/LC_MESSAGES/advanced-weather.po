#: lib/alerts.js:37
msgid "⚠️ Severe Weather Alert"
msgstr "⚠️ 恶劣天气警报"

#: lib/alerts.js:46
msgid "⚠️ Weather Warning"
msgstr "⚠️ 天气警告"

#: lib/alerts.js:66
msgid "🌡️ Extreme Heat Warning"
msgstr "🌡️ 高温警告"

#: lib/alerts.js:68
msgid "Dangerously high temperature"
msgstr "危险的高温"

#: lib/alerts.js:75
msgid "Stay indoors during peak hours (10 AM – 4 PM)"
msgstr "高峰时段（10:00–16:00）留在室内"

#: lib/alerts.js:76
msgid "Drink water regularly — at least 2–3 litres per day"
msgstr "定时喝水 — 每天至少 2–3 升"

#: lib/alerts.js:77
msgid "Wear light, loose, light-coloured clothing"
msgstr "穿着轻薄、宽松、浅色的衣物"

#: lib/alerts.js:78
msgid "Never leave children or pets in parked vehicles"
msgstr "切勿将儿童或宠物留在停放的车内"

#: lib/alerts.js:79
msgid "Check on elderly neighbours and relatives"
msgstr "探望年迈的邻居和亲属"

#: lib/alerts.js:80
msgid "Use fans or air conditioning if available"
msgstr "如有条件，使用风扇或空调"

#: lib/alerts.js:91
msgid "🥶 Extreme Cold Warning"
msgstr "🥶 严寒警告"

#: lib/alerts.js:93
msgid "Dangerously low temperature"
msgstr "危险的低温"

#: lib/alerts.js:100
msgid "Layer clothing: base layer, insulation, waterproof outer shell"
msgstr "分层穿衣：贴身层、保暖层、防水外层"

#: lib/alerts.js:101
msgid "Cover exposed skin — risk of frostbite within 30 minutes"
msgstr "遮盖裸露皮肤 — 30 分钟内可能被冻伤"

#: lib/alerts.js:102
msgid "Keep emergency supplies in your vehicle if driving"
msgstr "驾车时在车内备好应急物资"

#: lib/alerts.js:103
msgid "Check heating systems and carbon-monoxide detectors"
msgstr "检查供暖系统和一氧化碳报警器"

#: lib/alerts.js:104
msgid "Check on elderly and vulnerable people"
msgstr "关照老人和弱势群体"

#: lib/alerts.js:105
msgid "Bring pets indoors"
msgstr "将宠物带入室内"

#: lib/alerts.js:117
msgid "🌀 Severe Storm Warning"
msgstr "🌀 强风暴警告"

#: lib/alerts.js:119
msgid "Dangerous wind speed"
msgstr "危险风速"

#: lib/alerts.js:121
msgid "Avoid all unnecessary travel"
msgstr "避免一切不必要的出行"

#: lib/alerts.js:122
msgid "Stay away from trees, scaffolding, and signs"
msgstr "远离树木、脚手架和广告牌"

#: lib/alerts.js:123
msgid "Do not attempt to drive high-sided vehicles"
msgstr "切勿驾驶高大的车辆"

#: lib/alerts.js:124
msgid "Secure or bring inside any outdoor furniture"
msgstr "固定或收起户外家具"

#: lib/alerts.js:125
msgid "Stay indoors away from windows"
msgstr "留在室内，远离窗户"

#: lib/alerts.js:126
msgid "Follow local emergency service guidance"
msgstr "遵循当地应急部门的指引"

#: lib/alerts.js:135
msgid "💨 Strong Wind Warning"
msgstr "💨 大风警告"

#: lib/alerts.js:137
msgid "Strong winds detected"
msgstr "检测到强风"

#: lib/alerts.js:140
msgid ""
"Take care when walking or cycling — gusts may be stronger than the average"
msgstr "步行或骑行时要小心 — 阵风可能强于平均风速"

#: lib/alerts.js:142
msgid "Secure loose outdoor items (bins, garden furniture, etc.)"
msgstr "固定好室外的活动物品（垃圾桶、花园家具等）"

#: lib/alerts.js:143
msgid "Drive with extra caution, especially on exposed roads or bridges"
msgstr "格外小心驾驶，尤其在开阔路段和桥梁上"

#: lib/alerts.js:144
msgid "Cyclists and motorcyclists should be especially cautious"
msgstr "骑车者和摩托车驾驶者需格外小心"

#: lib/alerts.js:158
msgid "Seek shelter immediately in a sturdy building"
msgstr "立即进入坚固建筑物躲避"

#: lib/alerts.js:159
msgid "Avoid open fields, hilltops, and isolated trees"
msgstr "避开空旷田野、山顶和孤立的树木"

#: lib/alerts.js:160
msgid "Stay away from water, metal objects, and electrical equipment"
msgstr "远离水、金属物体和电气设备"

#: lib/alerts.js:161
msgid "If outdoors and unable to shelter, crouch low — do not lie flat"
msgstr "如在户外无法躲避，请低蹲 — 不要平躺"

#: lib/alerts.js:162
msgid "Avoid using corded phones or plugged-in devices"
msgstr "避免使用有线电话或插电设备"

#: lib/alerts.js:163
msgid "Keep away from windows and doors"
msgstr "远离门窗"

#: lib/alerts.js:167
msgid "Follow official emergency service guidance"
msgstr "遵循官方应急部门的指引"

#: lib/alerts.js:168
msgid "Stay informed via local weather services"
msgstr "关注当地气象部门"

#: lib/alerts.js:169
msgid "Avoid non-essential travel"
msgstr "避免非必要出行"

#: lib/alerts.js:178
msgid "Avoid driving through flooded roads — even 30 cm can sweep a car away"
msgstr "避免驶过积水路段 — 仅 30 厘米的水深也能冲走汽车"

#: lib/alerts.js:180
msgid "Be aware of localised flooding in low-lying areas"
msgstr "注意低洼地区的局部积水"

#: lib/alerts.js:181
msgid "Carry waterproof clothing if you must travel"
msgstr "如必须出行，请携带防水衣物"

#: lib/alerts.js:182
msgid "Check your local flood risk map"
msgstr "查看当地的洪水风险地图"

#: lib/alerts.js:188
msgid "Avoid travel unless absolutely necessary"
msgstr "除非绝对必要，避免外出"

#: lib/alerts.js:189
msgid "If driving, carry a winter emergency kit (blanket, shovel, water)"
msgstr "若驾车，请携带冬季应急包（毯子、铲子、水）"

#: lib/alerts.js:190
msgid "Clear snow from paths and driveways carefully to avoid injury"
msgstr "小心清除道路和车道上的积雪，以免受伤"

#: lib/alerts.js:191
msgid "Be aware of roof loading from heavy snow accumulation"
msgstr "注意屋顶积雪过重"

#: lib/alerts.js:195
msgid "Exercise caution outdoors"
msgstr "户外活动时要小心"

#: lib/alerts.js:196
msgid "Stay informed via local weather forecasts"
msgstr "关注当地天气预报"

