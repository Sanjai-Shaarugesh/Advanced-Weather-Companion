#: extension.js:619
msgid "Advanced Weather"
msgstr "สภาพอากาศขั้นสูง"

#: extension.js:627
msgid "What to do:"
msgstr "สิ่งที่ควรทำ:"

#: lib/alerts.js:37
msgid "⚠️ Severe Weather Alert"
msgstr "⚠️ แจ้งเตือนสภาพอากาศรุนแรง"

#: lib/alerts.js:46
msgid "⚠️ Weather Warning"
msgstr "⚠️ ประกาศเตือนสภาพอากาศ"

#: lib/alerts.js:66
msgid "🌡️ Extreme Heat Warning"
msgstr "🌡️ ประกาศเตือนอากาศร้อนจัด"

#: lib/alerts.js:68
msgid "Dangerously high temperature"
msgstr "อุณหภูมิสูงอย่างอันตราย"

#: lib/alerts.js:75
msgid "Stay indoors during peak hours (10 AM – 4 PM)"
msgstr "อยู่ในอาคารช่วงพีค (10:00–16:00)"

#: lib/alerts.js:76
msgid "Drink water regularly — at least 2–3 litres per day"
msgstr "ดื่มน้ำสม่ำเสมอ — อย่างน้อย 2–3 ลิตรต่อวัน"

#: lib/alerts.js:77
msgid "Wear light, loose, light-coloured clothing"
msgstr "สวมเสื้อผ้าเบา หลวม สีอ่อน"

#: lib/alerts.js:78
msgid "Never leave children or pets in parked vehicles"
msgstr "ห้ามทิ้งเด็กหรือสัตว์เลี้ยงไว้ในรถที่จอดไว้"

#: lib/alerts.js:79
msgid "Check on elderly neighbours and relatives"
msgstr "ดูแลเพื่อนบ้านและญาติผู้สูงอายุ"

#: lib/alerts.js:80
msgid "Use fans or air conditioning if available"
msgstr "ใช้พัดลมหรือเครื่องปรับอากาศหากมี"

#: lib/alerts.js:91
msgid "🥶 Extreme Cold Warning"
msgstr "🥶 ประกาศเตือนอากาศหนาวจัด"

#: lib/alerts.js:93
msgid "Dangerously low temperature"
msgstr "อุณหภูมิต่ำอย่างอันตราย"

#: lib/alerts.js:100
msgid "Layer clothing: base layer, insulation, waterproof outer shell"
msgstr "สวมเสื้อผ้าหลายชั้น: ชั้นใน ชั้นกันหนาว ชั้นนอกกันน้ำ"

#: lib/alerts.js:101
msgid "Cover exposed skin — risk of frostbite within 30 minutes"
msgstr "ปกปิดผิวหนังที่โผล่ — เสี่ยงถูกน้ำแข็งกัดภายใน 30 นาที"

#: lib/alerts.js:102
msgid "Keep emergency supplies in your vehicle if driving"
msgstr "เตรียมสิ่งของฉุกเฉินไว้ในรถหากขับรถ"

#: lib/alerts.js:103
msgid "Check heating systems and carbon-monoxide detectors"
msgstr "ตรวจระบบทำความร้อนและเครื่องตรวจจับคาร์บอนมอนอกไซด์"

#: lib/alerts.js:104
msgid "Check on elderly and vulnerable people"
msgstr "ดูแลผู้สูงอายุและผู้เปราะบาง"

#: lib/alerts.js:105
msgid "Bring pets indoors"
msgstr "นำสัตว์เลี้ยงเข้าในบ้าน"

#: lib/alerts.js:117
msgid "🌀 Severe Storm Warning"
msgstr "🌀 ประกาศเตือนพายุรุนแรง"

#: lib/alerts.js:119
msgid "Dangerous wind speed"
msgstr "ความเร็วลมอันตราย"

#: lib/alerts.js:121
msgid "Avoid all unnecessary travel"
msgstr "หลีกเลี่ยงการเดินทางที่ไม่จำเป็นทั้งหมด"

#: lib/alerts.js:122
msgid "Stay away from trees, scaffolding, and signs"
msgstr "อยู่ให้ห่างจากต้นไม้ นั่งร้าน และป้าย"

#: lib/alerts.js:123
msgid "Do not attempt to drive high-sided vehicles"
msgstr "อย่าพยายามขับรถที่มีตัวถังสูง"

#: lib/alerts.js:124
msgid "Secure or bring inside any outdoor furniture"
msgstr "ยึดหรือนำเฟอร์นิเจอร์กลางแจ้งเข้าข้างใน"

#: lib/alerts.js:125
msgid "Stay indoors away from windows"
msgstr "อยู่ในอาคารและอยู่ให้ห่างจากหน้าต่าง"

#: lib/alerts.js:126
msgid "Follow local emergency service guidance"
msgstr "ปฏิบัติตามคำแนะนำของหน่วยงานฉุกเฉินในพื้นที่"

#: lib/alerts.js:135
msgid "💨 Strong Wind Warning"
msgstr "💨 ประกาศเตือนลมแรง"

#: lib/alerts.js:137
msgid "Strong winds detected"
msgstr "ตรวจพบลมแรง"

#: lib/alerts.js:140
msgid ""
"Take care when walking or cycling — gusts may be stronger than the average"
msgstr "ระมัดระวังเมื่อเดินหรือขี่จักรยาน — ลมกระโชกอาจแรงกว่าค่าเฉลี่ย"

#: lib/alerts.js:142
msgid "Secure loose outdoor items (bins, garden furniture, etc.)"
msgstr "ยึดสิ่งของนอกบ้านที่หลุดง่าย (ถังขยะ เฟอร์นิเจอร์สนาม ฯลฯ)"

#: lib/alerts.js:143
msgid "Drive with extra caution, especially on exposed roads or bridges"
msgstr "ขับรถอย่างระมัดระวังเป็นพิเศษ โดยเฉพาะถนนโล่งและสะพาน"

#: lib/alerts.js:144
msgid "Cyclists and motorcyclists should be especially cautious"
msgstr "ผู้ขี่จักรยานและผู้ขับขี่มอเตอร์ไซค์ควรระมัดระวังเป็นพิเศษ"

#: lib/alerts.js:158
msgid "Seek shelter immediately in a sturdy building"
msgstr "เข้าที่หลบภัยในอาคารแข็งแรงทันที"

#: lib/alerts.js:159
msgid "Avoid open fields, hilltops, and isolated trees"
msgstr "หลีกเลี่ยงทุ่งโล่ง ยอดเขา และต้นไม้โดดเดี่ยว"

#: lib/alerts.js:160
msgid "Stay away from water, metal objects, and electrical equipment"
msgstr "อยู่ให้ห่างจากน้ำ วัตถุโลหะ และอุปกรณ์ไฟฟ้า"

#: lib/alerts.js:161
msgid "If outdoors and unable to shelter, crouch low — do not lie flat"
msgstr "หากอยู่กลางแจ้งและหลบไม่ได้ ให้หมอบต่ำ — ไม่นอนราบ"

#: lib/alerts.js:162
msgid "Avoid using corded phones or plugged-in devices"
msgstr "หลีกเลี่ยงการใช้โทรศัพท์มีสายและอุปกรณ์ที่เสียบปลั๊ก"

#: lib/alerts.js:163
msgid "Keep away from windows and doors"
msgstr "อยู่ให้ห่างจากหน้าต่างและประตู"

#: lib/alerts.js:167
msgid "Follow official emergency service guidance"
msgstr "ปฏิบัติตามคำแนะนำอย่างเป็นทางการของหน่วยงานฉุกเฉิน"

#: lib/alerts.js:168
msgid "Stay informed via local weather services"
msgstr "ติดตามข้อมูลจากหน่วยงานอากาศในท้องถิ่น"

#: lib/alerts.js:169
msgid "Avoid non-essential travel"
msgstr "หลีกเลี่ยงการเดินทางที่ไม่จำเป็น"

#: lib/alerts.js:178
msgid "Avoid driving through flooded roads — even 30 cm can sweep a car away"
msgstr "อย่าขับรถผ่านถนนที่น้ำท่วม — แค่ 30 ซม. ก็พัดรถหายได้"

#: lib/alerts.js:180
msgid "Be aware of localised flooding in low-lying areas"
msgstr "ระวังน้ำท่วมขังเฉพาะจุดในพื้นที่ลุ่ม"

#: lib/alerts.js:181
msgid "Carry waterproof clothing if you must travel"
msgstr "พกเสื้อผ้ากันน้ำหากจำเป็นต้องเดินทาง"

#: lib/alerts.js:182
msgid "Check your local flood risk map"
msgstr "ตรวจสอบแผนที่ความเสี่ยงน้ำท่วมในท้องถิ่น"

#: lib/alerts.js:188
msgid "Avoid travel unless absolutely necessary"
msgstr "หลีกเลี่ยงการเดินทางหากไม่จำเป็นจริง ๆ"

#: lib/alerts.js:189
msgid "If driving, carry a winter emergency kit (blanket, shovel, water)"
msgstr "หากขับรถ ให้พกชุดฉุกเฉินฤดูหนาว (ผ้าห่ม พลั่ว น้ำ)"

#: lib/alerts.js:190
msgid "Clear snow from paths and driveways carefully to avoid injury"
msgstr ""
"กวาดหิมะออกจากทางเดินและทางเข้าอย่างระมัดระวังเพื่อป้องกันอาการบาดเจ็บ"

#: lib/alerts.js:191
msgid "Be aware of roof loading from heavy snow accumulation"
msgstr "ระวังน้ำหนักบนหลังคาจากหิมะที่ทับถม"

#: lib/alerts.js:195
msgid "Exercise caution outdoors"
msgstr "ระมัดระวังเมื่ออยู่กลางแจ้ง"

#: lib/alerts.js:196
msgid "Stay informed via local weather forecasts"
msgstr "ติดตามพยากรณ์อากาศในท้องถิ่น"

